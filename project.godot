; Engine configuration file.
config_version=5

[application]

config/name="Velocity"
config/description="VELOCITY: Anti-Gravity League. An original anti-gravity racing game."
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=0
boot_splash/bg_color=Color(0.02, 0.025, 0.04, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Settings="*res://src/core/settings.gd"
SaveData="*res://src/core/save_data.gd"
Quality="*res://src/core/quality.gd"
Audio="*res://src/audio/audio.gd"
Game="*res://src/core/game.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/unused_signal=0
gdscript/warnings/confusable_local_declaration=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[gui]

theme/custom_font="res://assets/fonts/Rajdhani-SemiBold.ttf"

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0

[rendering]

rendering_device/fallback_to_opengl3=true

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=0
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.04, 1)
textures/default_filters/anisotropic_filtering_level=2
